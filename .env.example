# ==========================================
# CONFIGURAÇÕES DO CHATBOT CPD / WHATSAPP
# ==========================================

# Chave de API do Google Gemini (obtenha em https://aistudio.google.com/)
GEMINI_API_KEY=AIzaSy...

# Modelo do Gemini para respostas rápidas e econômicas (Flash)
GEMINI_MODEL=gemini-3.5-flash-lite

# Modo de teste: se true, o bot só responderá aos números da lista de permissão
MODO_TESTE=true

# Lista de números autorizados no modo teste (separados por vírgula, com DDI + DDD + Número)
# Exemplo: 5511999999999,5511988888888
NUMEROS_PERMITIDOS=5511999999999,5511988888888

# Delay humano antes de responder (em milissegundos)
DELAY_MIN_MS=2000
DELAY_MAX_MS=4000
DIGITANDO_MS=1500

# Nome do Atendente Humano e WhatsApp para Transbordo
NOME_TECNICO=Suporte CPD
TECNICO_WHATSAPP=5511999999999

# Acesso ao Painel de Administração
ADMIN_USER=admin
ADMIN_PASS=mude_essa_senha_forte
ADMIN_SECRET=gere_uma_chave_secreta_aleatoria_aqui
